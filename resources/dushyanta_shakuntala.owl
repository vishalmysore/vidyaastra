<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE rdf:RDF [
    <!ENTITY owl "http://www.w3.org/2002/07/owl#" >
    <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#" >
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#" >
    <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#" >
    <!ENTITY shakuntala "http://vidyaastra.org/ontology/shakuntala#" >
]>

<rdf:RDF xmlns="http://vidyaastra.org/ontology/shakuntala#"
     xml:base="http://vidyaastra.org/ontology/shakuntala"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:shakuntala="http://vidyaastra.org/ontology/shakuntala#">
    
    <owl:Ontology rdf:about="http://vidyaastra.org/ontology/shakuntala">
        <rdfs:label>Abhijnanasakuntalam Ontology</rdfs:label>
        <rdfs:comment>An ontology for Abhijnanasakuntalam (The Recognition of Shakuntala), a Sanskrit play by Kalidasa</rdfs:comment>
        <owl:versionInfo>1.0</owl:versionInfo>
        <rdfs:seeAlso>One of the greatest works of Sanskrit literature, the story of King Dushyanta and Shakuntala</rdfs:seeAlso>
    </owl:Ontology>

    <!-- Classes -->
    
    <owl:Class rdf:about="&shakuntala;Character">
        <rdfs:label>Character</rdfs:label>
        <rdfs:comment>A character in the play</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Hero">
        <rdfs:label>Hero</rdfs:label>
        <rdfs:subClassOf rdf:resource="&shakuntala;Character"/>
        <rdfs:comment>Male protagonist</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Heroine">
        <rdfs:label>Heroine</rdfs:label>
        <rdfs:subClassOf rdf:resource="&shakuntala;Character"/>
        <rdfs:comment>Female protagonist</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;King">
        <rdfs:label>King</rdfs:label>
        <rdfs:subClassOf rdf:resource="&shakuntala;Character"/>
        <rdfs:comment>Royal ruler</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Sage">
        <rdfs:label>Sage</rdfs:label>
        <rdfs:subClassOf rdf:resource="&shakuntala;Character"/>
        <rdfs:comment>Wise ascetic or hermit</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Apsara">
        <rdfs:label>Apsara</rdfs:label>
        <rdfs:subClassOf rdf:resource="&shakuntala;Character"/>
        <rdfs:comment>Celestial nymph</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Deity">
        <rdfs:label>Deity</rdfs:label>
        <rdfs:subClassOf rdf:resource="&shakuntala;Character"/>
        <rdfs:comment>Divine being</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Companion">
        <rdfs:label>Companion</rdfs:label>
        <rdfs:subClassOf rdf:resource="&shakuntala;Character"/>
        <rdfs:comment>Friend or attendant</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Minister">
        <rdfs:label>Minister</rdfs:label>
        <rdfs:subClassOf rdf:resource="&shakuntala;Character"/>
        <rdfs:comment>Royal advisor</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Place">
        <rdfs:label>Place</rdfs:label>
        <rdfs:comment>Geographic location</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Hermitage">
        <rdfs:label>Hermitage</rdfs:label>
        <rdfs:subClassOf rdf:resource="&shakuntala;Place"/>
        <rdfs:comment>Ashram or retreat of sages</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Palace">
        <rdfs:label>Palace</rdfs:label>
        <rdfs:subClassOf rdf:resource="&shakuntala;Place"/>
        <rdfs:comment>Royal residence</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Heaven">
        <rdfs:label>Heaven</rdfs:label>
        <rdfs:subClassOf rdf:resource="&shakuntala;Place"/>
        <rdfs:comment>Celestial realm</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Kingdom">
        <rdfs:label>Kingdom</rdfs:label>
        <rdfs:comment>Political realm</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Event">
        <rdfs:label>Event</rdfs:label>
        <rdfs:comment>Significant occurrence</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Meeting">
        <rdfs:label>Meeting</rdfs:label>
        <rdfs:subClassOf rdf:resource="&shakuntala;Event"/>
        <rdfs:comment>First encounter between characters</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Marriage">
        <rdfs:label>Marriage</rdfs:label>
        <rdfs:subClassOf rdf:resource="&shakuntala;Event"/>
        <rdfs:comment>Gandharva marriage (love marriage)</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Curse">
        <rdfs:label>Curse</rdfs:label>
        <rdfs:subClassOf rdf:resource="&shakuntala;Event"/>
        <rdfs:comment>Divine curse or punishment</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Recognition">
        <rdfs:label>Recognition</rdfs:label>
        <rdfs:subClassOf rdf:resource="&shakuntala;Event"/>
        <rdfs:comment>Moment of recognition or realization</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Journey">
        <rdfs:label>Journey</rdfs:label>
        <rdfs:subClassOf rdf:resource="&shakuntala;Event"/>
        <rdfs:comment>Travel from one place to another</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Artifact">
        <rdfs:label>Artifact</rdfs:label>
        <rdfs:comment>Significant object</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Ring">
        <rdfs:label>Ring</rdfs:label>
        <rdfs:subClassOf rdf:resource="&shakuntala;Artifact"/>
        <rdfs:comment>Recognition ring given by Dushyanta</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Act">
        <rdfs:label>Act</rdfs:label>
        <rdfs:comment>Act or section of the play (total 7 acts)</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="&shakuntala;Emotion">
        <rdfs:label>Emotion</rdfs:label>
        <rdfs:comment>Emotional state or rasa</rdfs:comment>
    </owl:Class>

    <!-- Object Properties -->
    
    <owl:ObjectProperty rdf:about="&shakuntala;loves">
        <rdfs:label>loves</rdfs:label>
        <rdfs:domain rdf:resource="&shakuntala;Character"/>
        <rdfs:range rdf:resource="&shakuntala;Character"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="&shakuntala;marriedTo">
        <rdfs:label>married to</rdfs:label>
        <rdfs:domain rdf:resource="&shakuntala;Character"/>
        <rdfs:range rdf:resource="&shakuntala;Character"/>
        <rdf:type rdf:resource="&owl;SymmetricProperty"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="&shakuntala;fatherOf">
        <rdfs:label>father of</rdfs:label>
        <rdfs:domain rdf:resource="&shakuntala;Character"/>
        <rdfs:range rdf:resource="&shakuntala;Character"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="&shakuntala;motherOf">
        <rdfs:label>mother of</rdfs:label>
        <rdfs:domain rdf:resource="&shakuntala;Character"/>
        <rdfs:range rdf:resource="&shakuntala;Character"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="&shakuntala;fosterFatherOf">
        <rdfs:label>foster father of</rdfs:label>
        <rdfs:domain rdf:resource="&shakuntala;Sage"/>
        <rdfs:range rdf:resource="&shakuntala;Character"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="&shakuntala;rulesOver">
        <rdfs:label>rules over</rdfs:label>
        <rdfs:domain rdf:resource="&shakuntala;King"/>
        <rdfs:range rdf:resource="&shakuntala;Kingdom"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="&shakuntala;residesIn">
        <rdfs:label>resides in</rdfs:label>
        <rdfs:domain rdf:resource="&shakuntala;Character"/>
        <rdfs:range rdf:resource="&shakuntala;Place"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="&shakuntala;visitsPlace">
        <rdfs:label>visits place</rdfs:label>
        <rdfs:domain rdf:resource="&shakuntala;Character"/>
        <rdfs:range rdf:resource="&shakuntala;Place"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="&shakuntala;curses">
        <rdfs:label>curses</rdfs:label>
        <rdfs:domain rdf:resource="&shakuntala;Sage"/>
        <rdfs:range rdf:resource="&shakuntala;Character"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="&shakuntala;recognizes">
        <rdfs:label>recognizes</rdfs:label>
        <rdfs:domain rdf:resource="&shakuntala;Character"/>
        <rdfs:range rdf:resource="&shakuntala;Character"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="&shakuntala;befriends">
        <rdfs:label>befriends</rdfs:label>
        <rdfs:domain rdf:resource="&shakuntala;Character"/>
        <rdfs:range rdf:resource="&shakuntala;Character"/>
        <rdf:type rdf:resource="&owl;SymmetricProperty"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="&shakuntala;gives">
        <rdfs:label>gives</rdfs:label>
        <rdfs:domain rdf:resource="&shakuntala;Character"/>
        <rdfs:range rdf:resource="&shakuntala;Artifact"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="&shakuntala;loses">
        <rdfs:label>loses</rdfs:label>
        <rdfs:domain rdf:resource="&shakuntala;Character"/>
