        <rdfs:range rdf:resource="&shakuntala;Event"/>
    </owl:ObjectProperty>

    <!-- Data Properties -->
    
    <owl:DatatypeProperty rdf:about="&shakuntala;name">
        <rdfs:label>name</rdfs:label>
        <rdfs:domain rdf:resource="&shakuntala;Character"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="&shakuntala;title">
        <rdfs:label>title</rdfs:label>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="&shakuntala;description">
        <rdfs:label>description</rdfs:label>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="&shakuntala;actNumber">
        <rdfs:label>act number</rdfs:label>
        <rdfs:domain rdf:resource="&shakuntala;Act"/>
        <rdfs:range rdf:resource="&xsd;integer"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="&shakuntala;dialogue">
        <rdfs:label>dialogue</rdfs:label>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="&shakuntala;beauty">
        <rdfs:label>beauty</rdfs:label>
        <rdfs:domain rdf:resource="&shakuntala;Character"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>

    <!-- Named Individuals - Main Characters -->
    
    <owl:NamedIndividual rdf:about="&shakuntala;Shakuntala">
        <rdf:type rdf:resource="&shakuntala;Heroine"/>
        <shakuntala:name>Shakuntala</shakuntala:name>
        <shakuntala:title>Foster daughter of Sage Kanva</shakuntala:title>
        <shakuntala:description>The beautiful heroine, daughter of Sage Vishwamitra and Apsara Menaka, raised in the forest hermitage</shakuntala:description>
        <shakuntala:beauty>Compared to a jasmine flower among thorny bushes</shakuntala:beauty>
        <rdfs:comment>Shakuntala embodies ideal womanhood in Sanskrit literature</rdfs:comment>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="&shakuntala;Dushyanta">
        <rdf:type rdf:resource="&shakuntala;Hero"/>
        <rdf:type rdf:resource="&shakuntala;King"/>
        <shakuntala:name>Dushyanta</shakuntala:name>
        <shakuntala:title>King of Hastinapura</shakuntala:title>
        <shakuntala:description>The heroic king who falls in love with Shakuntala while hunting, forgets her due to curse, then recognizes her</shakuntala:description>
        <shakuntala:loves rdf:resource="&shakuntala;Shakuntala"/>
        <shakuntala:marriedTo rdf:resource="&shakuntala;Shakuntala"/>
        <rdfs:comment>Ancestor of the Pandavas and Kauravas of the Mahabharata</rdfs:comment>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="&shakuntala;Bharata">
        <rdf:type rdf:resource="&shakuntala;Character"/>
        <shakuntala:name>Bharata</shakuntala:name>
        <shakuntala:title>Son of Dushyanta and Shakuntala</shakuntala:title>
        <shakuntala:description>The child who plays with lion cubs and later becomes a great emperor</shakuntala:description>
        <rdfs:comment>After whom India (Bharata) is named; ancestor of both Pandavas and Kauravas</rdfs:comment>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="&shakuntala;Kanva">
        <rdf:type rdf:resource="&shakuntala;Sage"/>
        <shakuntala:name>Kanva</shakuntala:name>
        <shakuntala:title>Sage and foster father of Shakuntala</shakuntala:title>
        <shakuntala:description>The wise sage who raises Shakuntala in his hermitage</shakuntala:description>
        <shakuntala:fosterFatherOf rdf:resource="&shakuntala;Shakuntala"/>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="&shakuntala;Durvasa">
        <rdf:type rdf:resource="&shakuntala;Sage"/>
        <shakuntala:name>Durvasa</shakuntala:name>
        <shakuntala:title>Irascible sage known for his curses</shakuntala:title>
        <shakuntala:description>The sage who curses Shakuntala when she fails to attend to him properly</shakuntala:description>
        <shakuntala:curses rdf:resource="&shakuntala;Shakuntala"/>
        <rdfs:comment>Famous in Hindu mythology for his terrible temper and powerful curses</rdfs:comment>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="&shakuntala;Menaka">
        <rdf:type rdf:resource="&shakuntala;Apsara"/>
        <shakuntala:name>Menaka</shakuntala:name>
        <shakuntala:title>Celestial nymph</shakuntala:title>
        <shakuntala:description>Apsara sent by Indra to seduce Vishwamitra, mother of Shakuntala</shakuntala:description>
        <shakuntala:motherOf rdf:resource="&shakuntala;Shakuntala"/>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="&shakuntala;Vishwamitra">
        <rdf:type rdf:resource="&shakuntala;Sage"/>
        <shakuntala:name>Vishwamitra</shakuntala:name>
        <shakuntala:title>Great sage</shakuntala:title>
        <shakuntala:description>The powerful sage who fathers Shakuntala with Menaka</shakuntala:description>
        <shakuntala:fatherOf rdf:resource="&shakuntala;Shakuntala"/>
    </owl:NamedIndividual>
    
    <!-- Companions of Shakuntala -->
    
    <owl:NamedIndividual rdf:about="&shakuntala;Priyamvada">
        <rdf:type rdf:resource="&shakuntala;Companion"/>
        <shakuntala:name>Priyamvada</shakuntala:name>
        <shakuntala:title>Friend of Shakuntala</shakuntala:title>
        <shakuntala:befriends rdf:resource="&shakuntala;Shakuntala"/>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="&shakuntala;Anasuya">
        <rdf:type rdf:resource="&shakuntala;Companion"/>
        <shakuntala:name>Anasuya</shakuntala:name>
        <shakuntala:title>Friend of Shakuntala</shakuntala:title>
        <shakuntala:befriends rdf:resource="&shakuntala;Shakuntala"/>
    </owl:NamedIndividual>
    
    <!-- Places -->
    
    <owl:NamedIndividual rdf:about="&shakuntala;KanvaHermitage">
        <rdf:type rdf:resource="&shakuntala;Hermitage"/>
        <shakuntala:name>Kanva's Hermitage</shakuntala:name>
        <shakuntala:description>The peaceful forest ashram where Shakuntala is raised</shakuntala:description>
        <rdfs:comment>Located near the Malini river</rdfs:comment>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="&shakuntala;Hastinapura">
        <rdf:type rdf:resource="&shakuntala;Kingdom"/>
        <shakuntala:name>Hastinapura</shakuntala:name>
        <shakuntala:description>The capital kingdom ruled by Dushyanta</shakuntala:description>
    </owl:NamedIndividual>
    
    <!-- Key Artifacts -->
    
    <owl:NamedIndividual rdf:about="&shakuntala;RecognitionRing">
        <rdf:type rdf:resource="&shakuntala;Ring"/>
        <shakuntala:name>Ring of Recognition</shakuntala:name>
        <shakuntala:description>The signet ring given by Dushyanta to Shakuntala, inscribed with his name</shakuntala:description>
        <rdfs:comment>Lost in the Ganges, found in a fish's belly, leads to recognition</rdfs:comment>
    </owl:NamedIndividual>
    
    <!-- Key Events -->
    
    <owl:NamedIndividual rdf:about="&shakuntala;FirstMeeting">
        <rdf:type rdf:resource="&shakuntala;Meeting"/>
        <shakuntala:description>Dushyanta meets Shakuntala while hunting near the hermitage</shakuntala:description>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="&shakuntala;GandharvaMarriage">
        <rdf:type rdf:resource="&shakuntala;Marriage"/>
        <shakuntala:description>Dushyanta and Shakuntala marry in Gandharva style (love marriage without ceremony)</shakuntala:description>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="&shakuntala;DurvasasCurse">
        <rdf:type rdf:resource="&shakuntala;Curse"/>
        <shakuntala:description>Durvasa curses that Dushyanta will forget Shakuntala until he sees the ring of recognition</shakuntala:description>
        <rdfs:comment>The curse is the central plot device that creates the tragedy</rdfs:comment>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="&shakuntala;RecognitionScene">
        <rdf:type rdf:resource="&shakuntala;Recognition"/>
        <shakuntala:description>Dushyanta recognizes Shakuntala when the ring is found in a fish</shakuntala:description>
        <rdfs:comment>One of the most famous recognition scenes in world drama</rdfs:comment>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="&shakuntala;Reunion">
        <rdf:type rdf:resource="&shakuntala;Event"/>
        <shakuntala:description>Final reunion of Dushyanta, Shakuntala, and their son Bharata in heaven</shakuntala:description>
    </owl:NamedIndividual>
    
    <!-- Seven Acts -->
    
    <owl:NamedIndividual rdf:about="&shakuntala;Act1">
        <rdf:type rdf:resource="&shakuntala;Act"/>
        <shakuntala:actNumber>1</shakuntala:actNumber>
        <shakuntala:title>The Hunt</shakuntala:title>
        <shakuntala:description>Dushyanta meets Shakuntala while hunting</shakuntala:description>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="&shakuntala;Act2">
        <rdf:type rdf:resource="&shakuntala;Act"/>
        <shakuntala:actNumber>2</shakuntala:actNumber>
        <shakuntala:title>The Secret</shakuntala:title>
        <shakuntala:description>Dushyanta reveals his love</shakuntala:description>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="&shakuntala;Act3">
        <rdf:type rdf:resource="&shakuntala;Act"/>
        <shakuntala:actNumber>3</shakuntala:actNumber>
        <shakuntala:title>Lovesickness</shakuntala:title>
        <shakuntala:description>Shakuntala pines for Dushyanta</shakuntala:description>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="&shakuntala;Act4">
        <rdf:type rdf:resource="&shakuntala;Act"/>
        <shakuntala:actNumber>4</shakuntala:actNumber>
        <shakuntala:title>The Departure</shakuntala:title>
        <shakuntala:description>Shakuntala departs for Hastinapura; Durvasa's curse; ring is lost</shakuntala:description>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="&shakuntala;Act5">
        <rdf:type rdf:resource="&shakuntala;Act"/>
        <shakuntala:actNumber>5</shakuntala:actNumber>
        <shakuntala:title>The Rejection</shakuntala:title>
        <shakuntala:description>Dushyanta fails to recognize Shakuntala; she is taken to heaven</shakuntala:description>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="&shakuntala;Act6">
        <rdf:type rdf:resource="&shakuntala;Act"/>
        <shakuntala:actNumber>6</shakuntala:actNumber>
        <shakuntala:title>The Ring</shakuntala:title>
        <shakuntala:description>Ring is found; Dushyanta remembers and laments</shakuntala:description>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="&shakuntala;Act7">
        <rdf:type rdf:resource="&shakuntala;Act"/>
        <shakuntala:actNumber>7</shakuntala:actNumber>
        <shakuntala:title>The Recognition</shakuntala:title>
        <shakuntala:description>Reunion in heaven; Dushyanta meets his son Bharata</shakuntala:description>
    </owl:NamedIndividual>
    
    <!-- Emotions/Rasas -->
    
    <owl:NamedIndividual rdf:about="&shakuntala;Shringar">
        <rdf:type rdf:resource="&shakuntala;Emotion"/>
        <shakuntala:name>Shringar (Love/Romance)</shakuntala:name>
        <shakuntala:description>The dominant rasa of the play</shakuntala:description>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="&shakuntala;Karuna">
        <rdf:type rdf:resource="&shakuntala;Emotion"/>
        <shakuntala:name>Karuna (Pathos/Compassion)</shakuntala:name>
        <shakuntala:description>Evoked during separation and suffering</shakuntala:description>
    </owl:NamedIndividual>

</rdf:RDF>
