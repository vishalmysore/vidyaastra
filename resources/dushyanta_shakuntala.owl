    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="&shakuntala;finds">
        <rdfs:label>finds</rdfs:label>
        <rdfs:domain rdf:resource="&shakuntala;Character"/>
        <rdfs:range rdf:resource="&shakuntala;Artifact"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="&shakuntala;participatesIn">
        <rdfs:label>participates in</rdfs:label>
