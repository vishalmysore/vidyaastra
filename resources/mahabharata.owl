        <displayColor>#ff6b6b</displayColor><nodeSize rdf:datatype="xsd:int">26</nodeSize>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Abhimanyu">
