<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/mahabharata#"
     xml:base="http://example.org/mahabharata"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <owl:Ontology rdf:about="http://example.org/mahabharata">
        <rdfs:comment>Ontology generated from VidyaAstra Mahabharata graph (characters, factions, events, relationships).</rdfs:comment>
    </owl:Ontology>

    <!-- Annotation Properties -->
    <owl:AnnotationProperty rdf:about="http://example.org/mahabharata#displayColor"/>
    <owl:AnnotationProperty rdf:about="http://example.org/mahabharata#nodeSize"/>
    <owl:AnnotationProperty rdf:about="http://example.org/mahabharata#relationLabel"/>

    <!-- Classes -->
    <owl:Class rdf:about="http://example.org/mahabharata#Person"/>
    <owl:Class rdf:about="http://example.org/mahabharata#Hero">
        <rdfs:subClassOf rdf:resource="http://example.org/mahabharata#Person"/>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/mahabharata#Character">
        <rdfs:subClassOf rdf:resource="http://example.org/mahabharata#Person"/>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/mahabharata#Deity">
        <rdfs:subClassOf rdf:resource="http://example.org/mahabharata#Person"/>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/mahabharata#Event"/>
    <owl:Class rdf:about="http://example.org/mahabharata#Faction"/>

    <!-- Object Properties -->
    <owl:ObjectProperty rdf:about="http://example.org/mahabharata#hasFaction">
        <rdfs:domain rdf:resource="http://example.org/mahabharata#Person"/>
        <rdfs:range rdf:resource="http://example.org/mahabharata#Faction"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/mahabharata#relatedTo"/>
    <owl:ObjectProperty rdf:about="http://example.org/mahabharata#killed"/>
    <owl:ObjectProperty rdf:about="http://example.org/mahabharata#alliedWith">
        <owl:SymmetricProperty rdf:about="http://example.org/mahabharata#alliedWith"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/mahabharata#mentored"/>
    <owl:ObjectProperty rdf:about="http://example.org/mahabharata#divineRelationWith">
        <owl:SymmetricProperty rdf:about="http://example.org/mahabharata#divineRelationWith"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/mahabharata#participatesIn">
        <rdfs:domain rdf:resource="http://example.org/mahabharata#Person"/>
        <rdfs:range rdf:resource="http://example.org/mahabharata#Event"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/mahabharata#timelinePrecedes">
        <rdfs:domain rdf:resource="http://example.org/mahabharata#Event"/>
        <rdfs:range rdf:resource="http://example.org/mahabharata#Event"/>
    </owl:ObjectProperty>

    <!-- Faction Individuals -->
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#PandavaFaction">
        <rdf:type rdf:resource="http://example.org/mahabharata#Faction"/>
        <rdfs:label>Pandava</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#KauravaFaction">
        <rdf:type rdf:resource="http://example.org/mahabharata#Faction"/>
        <rdfs:label>Kaurava</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#NeutralFaction">
        <rdf:type rdf:resource="http://example.org/mahabharata#Faction"/>
        <rdfs:label>Neutral</rdfs:label>
    </owl:NamedIndividual>

    <!-- Event Individuals -->
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Birth_of_Kuru_Clan">
        <rdf:type rdf:resource="http://example.org/mahabharata#Event"/>
        <rdfs:label>Birth of Kuru Clan</rdfs:label>
        <rdfs:comment>The era beginning with Shantanu and Ganga.</rdfs:comment>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Dice_Game">
        <rdf:type rdf:resource="http://example.org/mahabharata#Event"/>
        <rdfs:label>Dice Game</rdfs:label>
        <rdfs:comment>Fateful gambling match: Pandavas lost kingdom &amp; freedom.</rdfs:comment>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#The_Exile_Vanavasa">
        <rdf:type rdf:resource="http://example.org/mahabharata#Event"/>
        <rdfs:label>The Exile (Vanavasa)</rdfs:label>
        <rdfs:comment>12 years of forest exile + 1 year incognito.</rdfs:comment>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Bhagavad_Gita_Event">
        <rdf:type rdf:resource="http://example.org/mahabharata#Event"/>
        <rdfs:label>Bhagavad Gita</rdfs:label>
        <rdfs:comment>The divine discourse by Krishna to Arjuna.</rdfs:comment>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Kurukshetra_War">
        <rdf:type rdf:resource="http://example.org/mahabharata#Event"/>
        <rdfs:label>Kurukshetra War</rdfs:label>
        <rdfs:comment>18-day apocalyptic war.</rdfs:comment>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Ascension_to_Heaven">
        <rdf:type rdf:resource="http://example.org/mahabharata#Event"/>
        <rdfs:label>Ascension to Heaven</rdfs:label>
        <rdfs:comment>The final journey of the Pandavas (Mahaprasthana).</rdfs:comment>
    </owl:NamedIndividual>

    <!-- Person Individuals (Heroes, Characters, Deities) -->
    <!-- Pandavas &amp; Immediate Family -->
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Yudhishthira">
        <rdf:type rdf:resource="http://example.org/mahabharata#Hero"/>
        <hasFaction rdf:resource="http://example.org/mahabharata#PandavaFaction"/>
        <rdfs:comment>Eldest Pandava | Known for dharma and righteousness.</rdfs:comment>
        <displayColor>#ff6b6b</displayColor><nodeSize rdf:datatype="xsd:int">28</nodeSize>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Bhima">
        <rdf:type rdf:resource="http://example.org/mahabharata#Hero"/>
        <hasFaction rdf:resource="http://example.org/mahabharata#PandavaFaction"/>
        <rdfs:comment>Strongest warrior | Killed Duryodhana and Dushasana.</rdfs:comment>
        <displayColor>#ff6b6b</displayColor><nodeSize rdf:datatype="xsd:int">26</nodeSize>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Arjuna">
        <rdf:type rdf:resource="http://example.org/mahabharata#Hero"/>
        <hasFaction rdf:resource="http://example.org/mahabharata#PandavaFaction"/>
        <rdfs:comment>Greatest archer | Listener of the Bhagavad Gita.</rdfs:comment>
        <displayColor>#ff6b6b</displayColor><nodeSize rdf:datatype="xsd:int">28</nodeSize>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Nakula">
        <rdf:type rdf:resource="http://example.org/mahabharata#Hero"/>
        <hasFaction rdf:resource="http://example.org/mahabharata#PandavaFaction"/>
        <rdfs:comment>Expert horseman | Twin brother of Sahadeva.</rdfs:comment>
        <displayColor>#ff6b6b</displayColor><nodeSize rdf:datatype="xsd:int">22</nodeSize>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Sahadeva">
        <rdf:type rdf:resource="http://example.org/mahabharata#Hero"/>
        <hasFaction rdf:resource="http://example.org/mahabharata#PandavaFaction"/>
        <rdfs:comment>Astrologer &amp; strategist | Twin brother of Nakula.</rdfs:comment>
        <displayColor>#ff6b6b</displayColor><nodeSize rdf:datatype="xsd:int">22</nodeSize>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Draupadi">
        <rdf:type rdf:resource="http://example.org/mahabharata#Hero"/>
        <hasFaction rdf:resource="http://example.org/mahabharata#PandavaFaction"/>
