    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Subhadra">
        <rdf:type rdf:resource="http://example.org/mahabharata#Character"/>
        <hasFaction rdf:resource="http://example.org/mahabharata#PandavaFaction"/>
        <rdfs:comment>Sister of Krishna | Wife of Arjuna | Mother of Abhimanyu.</rdfs:comment>
        <displayColor>#ffd700</displayColor><nodeSize rdf:datatype="xsd:int">20</nodeSize>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Dhrishtadyumna">
        <rdf:type rdf:resource="http://example.org/mahabharata#Hero"/>
        <hasFaction rdf:resource="http://example.org/mahabharata#PandavaFaction"/>
        <rdfs:comment>Commander of Pandava army | Killed Drona.</rdfs:comment>
        <displayColor>#ff6b6b</displayColor><nodeSize rdf:datatype="xsd:int">23</nodeSize>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Pandu">
        <rdf:type rdf:resource="http://example.org/mahabharata#Character"/>
        <hasFaction rdf:resource="http://example.org/mahabharata#PandavaFaction"/>
        <rdfs:comment>Nominal father of the Pandavas | King of Hastinapur.</rdfs:comment>
        <displayColor>#ffd700</displayColor><nodeSize rdf:datatype="xsd:int">20</nodeSize>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Madri">
        <rdf:type rdf:resource="http://example.org/mahabharata#Character"/>
        <hasFaction rdf:resource="http://example.org/mahabharata#PandavaFaction"/>
        <rdfs:comment>Second wife of Pandu | Mother of Nakula and Sahadeva.</rdfs:comment>
        <displayColor>#ffd700</displayColor><nodeSize rdf:datatype="xsd:int">19</nodeSize>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Upapandavas">
        <rdf:type rdf:resource="http://example.org/mahabharata#Character"/>
        <hasFaction rdf:resource="http://example.org/mahabharata#PandavaFaction"/>
        <rdfs:comment>The five sons of Draupadi (Prativindhya, Sutasoma, Shrutakarma, Satanika, Shrutasena), all killed by Ashwatthama.</rdfs:comment>
        <displayColor>#ff6b6b</displayColor><nodeSize rdf:datatype="xsd:int">18</nodeSize>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Chitrangada">
        <rdf:type rdf:resource="http://example.org/mahabharata#Character"/>
        <hasFaction rdf:resource="http://example.org/mahabharata#PandavaFaction"/>
        <rdfs:comment>Naga princess, one of Arjuna's wives.</rdfs:comment>
        <displayColor>#ffd700</displayColor><nodeSize rdf:datatype="xsd:int">16</nodeSize>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Uloopi">
        <rdf:type rdf:resource="http://example.org/mahabharata#Character"/>
        <hasFaction rdf:resource="http://example.org/mahabharata#PandavaFaction"/>
        <rdfs:comment>Naga princess, one of Arjuna's wives.</rdfs:comment>
        <displayColor>#ffd700</displayColor><nodeSize rdf:datatype="xsd:int">16</nodeSize>
    </owl:NamedIndividual>

