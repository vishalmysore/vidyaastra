    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Balarama">
        <rdf:type rdf:resource="http://example.org/mahabharata#Deity"/>
        <hasFaction rdf:resource="http://example.org/mahabharata#NeutralFaction"/>
        <rdfs:comment>Elder brother of Krishna | Master of Mace warfare (Gada) | Remained Neutral.</rdfs:comment>
        <displayColor>#a78bfa</displayColor><nodeSize rdf:datatype="xsd:int">25</nodeSize>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Vidura">
        <rdf:type rdf:resource="http://example.org/mahabharata#Character"/>
        <hasFaction rdf:resource="http://example.org/mahabharata#NeutralFaction"/>
        <rdfs:comment>Wise counselor | Half-brother to Dhritarashtra and Pandu | Voice of Dharma.</rdfs:comment>
        <displayColor>#34d399</displayColor><nodeSize rdf:datatype="xsd:int">21</nodeSize>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Ekalavya">
        <rdf:type rdf:resource="http://example.org/mahabharata#Hero"/>
