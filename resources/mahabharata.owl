        <hasFaction rdf:resource="http://example.org/mahabharata#PandavaFaction"/>
        <rdfs:comment>Son of Arjuna &amp; Subhadra | Killed in Chakravyuh.</rdfs:comment>
        <displayColor>#ff6b6b</displayColor><nodeSize rdf:datatype="xsd:int">20</nodeSize>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Ghatotkacha">
        <rdf:type rdf:resource="http://example.org/mahabharata#Hero"/>
        <hasFaction rdf:resource="http://example.org/mahabharata#PandavaFaction"/>
        <rdfs:comment>Son of Bhima and Hidimba | Rakshasa warrior.</rdfs:comment>
        <displayColor>#ff6b6b</displayColor><nodeSize rdf:datatype="xsd:int">21</nodeSize>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Kunti">
        <rdf:type rdf:resource="http://example.org/mahabharata#Character"/>
        <hasFaction rdf:resource="http://example.org/mahabharata#PandavaFaction"/>
