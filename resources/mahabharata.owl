        <hasFaction rdf:resource="http://example.org/mahabharata#KauravaFaction"/>
        <rdfs:comment>King of Madra | Forced Kaurava Ally | Karna's charioteer.</rdfs:comment>
        <displayColor>#4ecdc4</displayColor><nodeSize rdf:datatype="xsd:int">24</nodeSize>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/mahabharata#Jayadratha">
